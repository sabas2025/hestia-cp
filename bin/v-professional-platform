#!/bin/bash
# info: fixed administrative platform inventory, no arbitrary commands
set -eu
[[ $EUID == 0 && $# == 2 && $1 =~ ^[a-z][a-z0-9_]{1,29}$ ]] || exit 1
case "$2" in summary|docker|projects|backups|jobs) ;; *) exit 1 ;; esac
exec /usr/bin/python3 -I /usr/local/hestia/professional/platform_entry.py --actor "$1" --op "$2"
