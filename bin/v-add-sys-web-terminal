#!/bin/bash
# info: enable web terminal after runtime and service verification
# options: NONE
# Node upgrades are console operations: never replace a project runtime from a form.

# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source "$HESTIA/func/main.sh"
source_conf "$HESTIA/conf/hestia.conf"
check_hestia_demo_mode

node_version=$(/usr/bin/node --version 2>/dev/null) || node_version='unavailable'
if [[ ! "$node_version" =~ ^v([0-9]+)\.[0-9]+\.[0-9]+ ]] || (( BASH_REMATCH[1] < 24 )); then
	printf '%s\n' 'Web Terminal requires Node.js 24 or later. Install a reviewed runtime from the server console, or keep Web Terminal disabled to save other settings.' >&2
	exit 1
fi

# Preserve an existing healthy service; verify before declaring success.
if [[ "$WEB_TERMINAL" == true ]] && systemctl is-active --quiet hestia-web-terminal; then
	exit 0
fi

if [[ ! -f "$HESTIA/web-terminal/server.js" ]]; then
	apt-get -qq update || exit 1
	apt-get -qq --no-remove install hestia-web-terminal -y || exit 1
fi
[[ -f "$HESTIA/web-terminal/server.js" ]] || exit 1

systemctl start hestia-web-terminal || exit 1
systemctl enable hestia-web-terminal || exit 1
systemctl is-active --quiet hestia-web-terminal || exit 1
"$BIN/v-change-sys-config-value" WEB_TERMINAL true || exit 1
"$BIN/v-log-action" system Info 'Web Terminal' 'Web terminal enabled.'
log_event "$OK" "$ARGUMENTS"
