+    HST_STAGE_DIR=$(mktemp -d /tmp/hestia-install.XXXXXXXX) || hst_fail 'Cannot create private workspace'
+    chmod 700 "$HST_STAGE_DIR" || hst_fail 'Cannot protect workspace'
