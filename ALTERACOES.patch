+hst_asset() {
+    local name=$1 destination=$2 line hash url extra
+    line=$(awk -F '\t' -v id="$name" '$1==id {print; n++} END {if(n!=1) exit 1}' "$HST_BUNDLE_ROOT/install/assets.lock.tsv") || hst_fail "Missing unique asset lock: $name"
