+$account = ['WEB_DOMAINS' => '10', 'MAIL_DOMAINS' => '0', 'DNS_DOMAINS' => '0', 'DATABASES' => '2', 'CRON_JOBS' => '1', 'BACKUPS' => '1', 'TWOFA' => 'RECOVERY_SECRET', 'PASSWORD' => 'HASH_SECRET', 'U_DISK' => '340'];
+$calls = [];
