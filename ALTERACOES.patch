+child="$SCRIPT_DIR/hst-install-$HST_OS.sh"
+[[ -f $child && ! -L $child ]] || hst_fail 'Bundle incomplete: local installer missing'
+bash -n "$child" || hst_fail 'Local installer syntax error'
+exec bash "$child" "$@"
