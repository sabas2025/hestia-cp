+        rm -f -- "$HST_STAGE_DIR/admin-password" "$HST_STAGE_DIR/mysql-password" "$HST_STAGE_DIR/pgsql-password"
+        [[ $keep_stage == yes ]] || rm -rf -- "$HST_STAGE_DIR"
+    fi
+    unset vpass
